# user-service 환경변수 예시
# Docker 로컬 통합 실행 기준입니다. 운영 환경에서는 값을 반드시 변경하세요.
SERVICE_NAME=user-service
SERVICE_VERSION=0.1.0
DEBUG=false
LOG_FORMAT=json

DATABASE_URL=postgresql+asyncpg://micromart:micromart@micromart-postgres:5432/userdb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=15
REDIS_URL=redis://micromart-redis:6379/0

# JWT 키는 파일 경로 또는 PEM 문자열 중 하나의 방식으로 주입합니다.
JWT_PRIVATE_KEY_FILE=/run/secrets/private.pem
JWT_PUBLIC_KEY_FILE=/run/secrets/public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_PYTHON_EXCLUDED_URLS=health
