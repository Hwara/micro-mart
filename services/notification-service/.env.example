# notification-service 환경변수 예시
# Docker 로컬 통합 실행 기준입니다.

SERVICE_NAME=notification-service
SERVICE_VERSION=0.1.0
DEBUG=false
LOG_FORMAT=json

# NATS 브로커
NATS_URL=nats://micromart-nats:4222
NATS_SUBJECT_ORDER_COMPLETED=order.completed
NATS_CONNECT_TIMEOUT_SECONDS=5

# 알림 발송 시뮬레이션
NOTIFICATION_SEND_DELAY_MS=0
NOTIFICATION_FAILURE_RATE=0.0

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_PYTHON_EXCLUDED_URLS=health
