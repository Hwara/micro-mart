# order-service 환경변수 예시
# Docker 로컬 통합 실행 기준입니다. 운영 환경에서는 값을 반드시 변경하세요.

SERVICE_NAME=order-service
SERVICE_VERSION=0.1.0
DEBUG=false
LOG_FORMAT=json

# order-db 독립 인스턴스
DATABASE_URL=postgresql+asyncpg://micromart:micromart@micromart-postgres:5432/orderdb

# 내부 서비스 인증 토큰 (product/payment-service 호출 시 사용)
INTERNAL_SERVICE_TOKEN=change-me-in-production

# 낙관적 락 충돌 시 재시도 횟수
MAX_OPTIMISTIC_RETRY=3

# 하위 서비스 URL (docker-compose 네트워크 내 서비스명)
PRODUCT_SERVICE_URL=http://product-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000

# NATS 브로커
NATS_URL=nats://micromart-nats:4222

# 서비스 간 HTTP 호출 타임아웃 (초, float)
HTTP_TIMEOUT_SECONDS=5.0

# NATS 연결 타임아웃 (초, int)
NATS_CONNECT_TIMEOUT_SECONDS=5

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
