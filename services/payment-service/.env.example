# app/config.py에 적용되는 환경변수 예시
# 실제 운영환경 적용 시 값을 반드시 수정하세요.
SERVICE_NAME=payment-service
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://micromart:micromart@localhost:5432/paymentdb
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_FORMAT=pretty
DEBUG=true
INTERNAL_SERVICE_TOKEN=change-me-in-production

# Chaos Mode (기본값: 비활성화)
CHAOS_FAILURE_RATE=0.0
CHAOS_LATENCY_MS=0
CHAOS_DB_SLOWQUERY=false
