# payment-service 환경변수 예시
# Docker 로컬 통합 실행 기준입니다. 운영 환경에서는 값을 반드시 변경하세요.
SERVICE_NAME=payment-service
SERVICE_VERSION=0.1.0
DEBUG=false
LOG_FORMAT=json

DATABASE_URL=postgresql+asyncpg://micromart:micromart@micromart-postgres:5432/paymentdb
INTERNAL_SERVICE_TOKEN=change-me-in-production

# Chaos Mode (기본값: 비활성화)
CHAOS_FAILURE_RATE=0.0
CHAOS_LATENCY_MS=0
CHAOS_DB_SLOWQUERY=false

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
