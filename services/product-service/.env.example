# product-service 환경변수 예시
# Docker 로컬 통합 실행 기준입니다. 운영 환경에서는 값을 반드시 변경하세요.
SERVICE_NAME=product-service
SERVICE_VERSION=0.1.0
DEBUG=false
LOG_FORMAT=json

DATABASE_URL=postgresql+asyncpg://micromart:micromart@micromart-postgres:5432/productdb
REDIS_URL=redis://micromart-redis:6379/0
INTERNAL_SERVICE_TOKEN=change-me-in-production

REDIS_SOCKET_CONNECT_TIMEOUT=30.0
REDIS_SOCKET_TIMEOUT=30.0
PRODUCT_CACHE_TTL=300
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_PYTHON_EXCLUDED_URLS="health"
