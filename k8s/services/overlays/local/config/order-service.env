# order-service 환경변수 예시
# K8s 로컬 통합 실행 기준입니다. 운영 환경에서는 값을 반드시 변경하세요.

SERVICE_NAME=order-service
SERVICE_VERSION=0.1.0
DEBUG=false
LOG_FORMAT=json
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=5

# 낙관적 락 충돌 시 재시도 횟수
MAX_OPTIMISTIC_RETRY=3

# 하위 서비스 URL (K8s 네트워크 내 서비스명)
PRODUCT_SERVICE_URL=http://product-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000

# 서비스 간 HTTP 호출 타임아웃 (초, float)
HTTP_TIMEOUT_SECONDS=5.0

# NATS 연결 타임아웃 (초, int)
NATS_CONNECT_TIMEOUT_SECONDS=5

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.micro-mart.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_PYTHON_EXCLUDED_URLS=health
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=CUMULATIVE
