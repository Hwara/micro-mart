# product-service 환경변수 예시
# K8s 로컬 통합 실행 기준입니다. 운영 환경에서는 값을 반드시 변경하세요.
SERVICE_NAME=product-service
SERVICE_VERSION=0.1.0
DEBUG=true
LOG_FORMAT=json

REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
PRODUCT_CACHE_TTL=300
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.micro-mart.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_PYTHON_EXCLUDED_URLS=health
