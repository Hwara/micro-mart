# api-gateway 환경변수 예시
# K8s 로컬 통합 실행 기준입니다. 운영 환경에서는 값을 반드시 변경하세요.
SERVICE_NAME=api-gateway
SERVICE_VERSION=0.1.0
DEBUG=false
LOG_FORMAT=json

# 하위 서비스 URL (K8s 네트워크 기준)
USER_SERVICE_URL=http://user-service:8000
PRODUCT_SERVICE_URL=http://product-service:8000
ORDER_SERVICE_URL=http://order-service:8000

# JWKS 엔드포인트
JWKS_URL=http://user-service:8000/auth/jwks

# JWT
JWT_ALGORITHM=RS256
JWT_AUDIENCE=

# JWKS 캐시 TTL (초)
JWKS_CACHE_TTL_SECONDS=3600

# HTTP 타임아웃 (초)
HTTP_TIMEOUT_SECONDS=5.0

# Rate Limiting (분당 IP별 최대 요청 수)
RATE_LIMIT_PER_MINUTE=60

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.micro-mart.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_PYTHON_EXCLUDED_URLS=health
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=CUMULATIVE
